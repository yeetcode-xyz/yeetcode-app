NODE_ENV=development
YETCODE_API_KEY=your_api_key_here
FASTAPI_URL=http://localhost:6969

# Development Auto-Login (skips email verification, goes straight to your group)
# Set VITE_DEV_USE_AUTO_LOGIN=true to enable, then fill in your details
VITE_DEV_USE_AUTO_LOGIN=false
VITE_DEV_AUTO_LOGIN_USERNAME=your_leetcode_username
VITE_DEV_AUTO_LOGIN_EMAIL=your_email@example.com
VITE_DEV_AUTO_LOGIN_NAME=Your Name
VITE_DEV_AUTO_LOGIN_GROUP=your_group_id

# Logging Configuration
LOG_MODE=live
LOG_LEVEL=INFO
